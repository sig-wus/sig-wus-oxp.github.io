{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sig-wus.org/schema/platform.json",
  "title": "SIG WUS Platform Entry",
  "description": "Schema for a single wearable-ultrasound platform entry in the SIG-WUS catalog.",
  "type": "object",
  "required": [
    "id",
    "platform",
    "manufacturer",
    "category",
    "transducer",
    "tx",
    "rx",
    "specs",
    "application",
    "access",
    "availability"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique slug, lowercase, used for DOM ids."
    },
    "platform": {
      "type": "string",
      "description": "Display name of the platform."
    },
    "manufacturer": {
      "type": "string",
      "description": "Primary organization / institution responsible for the platform."
    },
    "affiliation": {
      "type": [
        "string",
        "null"
      ],
      "description": "Lab, group, or sub-organization within the manufacturer."
    },
    "reference": {
      "type": "string",
      "description": "Citation key (BibTeX)."
    },
    "category": {
      "type": "string",
      "enum": [
        "Pulse-echo non-imaging",
        "Pulse-echo imaging",
        "Non-pulse-echo (continuous wave Doppler)",
        "Other"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
    },
    "transducer": {
      "type": "object",
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "type": "string"
        },
        "field_of_view": {
          "type": "string"
        }
      }
    },
    "frequency": {
      "type": "string"
    },
    "depth": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "tx": {
      "type": "object",
      "properties": {
        "voltage": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        }
      }
    },
    "rx": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "sample_rate": {
          "type": "string"
        },
        "topology": {
          "type": "string"
        }
      }
    },
    "controller": {
      "type": "string",
      "description": "Sequencer + compute SoC/MCU/FPGA."
    },
    "data_link": {
      "type": "string",
      "description": "Wired / wireless interface and content."
    },
    "specs": {
      "type": "object",
      "properties": {
        "framerate": {
          "type": "string"
        },
        "weight": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "power": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "latency": {
          "type": "string"
        }
      }
    },
    "application": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "access": {
      "type": "string",
      "enum": [
        "open-source",
        "commercial",
        "research",
        "partial"
      ],
      "description": "Access model: open-source (HW+FW+SW publicly available), commercial (sold by vendor), research (academic-only, on request), partial (some artifacts released)."
    },
    "access_detail": {
      "type": "string",
      "description": "Free-form clarification of the access model (license, certification, channel)."
    },
    "paper": {
      "type": "string",
      "format": "uri"
    },
    "github": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "website": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "image": {
      "type": "string",
      "description": "Path to illustration/photo relative to this platform directory (typically assets/<filename>)."
    },
    "image_attribution": {
      "type": "object",
      "description": "Source attribution for the device image (credit, source URL, license, retrieval date).",
      "required": [
        "credit",
        "license",
        "retrieved"
      ],
      "properties": {
        "credit": {
          "type": "string",
          "description": "Who created or owns the image (author, lab, vendor, or 'Original illustration created for this catalog')."
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Canonical URL where the image was sourced from."
        },
        "license": {
          "type": "string",
          "description": "License or rights statement (CC-BY-4.0, CERN-OHL-S, vendor all-rights-reserved, CC0, etc.)."
        },
        "retrieved": {
          "type": "string",
          "description": "YYYY-MM when the image was retrieved."
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "hw",
        "sw",
        "purchase"
      ],
      "description": "Source availability (HW + SW) and purchase information.",
      "properties": {
        "hw": {
          "type": "object",
          "required": [
            "open_source",
            "schematics",
            "gerber",
            "bom"
          ],
          "properties": {
            "open_source": {
              "type": "boolean"
            },
            "schematics": {
              "type": "string",
              "enum": [
                "open",
                "partial",
                "closed",
                "planned"
              ],
              "description": "Schematic availability (electrical diagrams)."
            },
            "gerber": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "planned"
              ],
              "description": "PCB fabrication files availability."
            },
            "bom": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "planned"
              ],
              "description": "Bill of materials availability."
            },
            "license": {
              "type": [
                "string",
                "null"
              ]
            },
            "reference": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri",
              "description": "URL pointing to the canonical HW source."
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "description": "Free-form notes about HW availability."
            }
          }
        },
        "sw": {
          "type": "object",
          "required": [
            "open_source",
            "firmware",
            "host_software"
          ],
          "properties": {
            "open_source": {
              "type": "boolean"
            },
            "firmware": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "planned"
              ]
            },
            "host_software": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "planned"
              ]
            },
            "license": {
              "type": [
                "string",
                "null"
              ]
            },
            "reference": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri",
              "description": "URL pointing to the canonical SW source."
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "description": "Free-form notes about SW availability."
            }
          }
        },
        "purchase": {
          "type": "object",
          "required": [
            "available"
          ],
          "properties": {
            "available": {
              "type": "boolean",
              "description": "Can a third party obtain a built device."
            },
            "channel": {
              "type": [
                "string",
                "null"
              ],
              "description": "How/where the device can be obtained."
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "price_usd": {
              "type": [
                "number",
                "null"
              ],
              "description": "Typical unit price in USD (per device, ex-tax/ex-shipping). null = quote-based or not published."
            },
            "price_eur": {
              "type": [
                "number",
                "null"
              ],
              "description": "Typical unit price in EUR."
            },
            "price_note": {
              "type": [
                "string",
                "null"
              ],
              "description": "Free-form note about pricing, build cost, or procurement path."
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
